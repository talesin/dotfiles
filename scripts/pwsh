#!/usr/bin/env bash

WIN_SHIM_DBG_VAR=PWSH_DEBUG
WIN_SHIM_DBG_PREFIX='pwsh[dbg]'
source "$(dirname "$(realpath "$0")")/win-shim"

win_dbg "HOME=$HOME PWD=$PWD WSL_DISTRO_NAME=${WSL_DISTRO_NAME:-<unset>}"
win_dbg "WINDOWS_USERNAME=$(get_windows_username)"
win_dbg "argc=$# argv=($*)"

native_passthrough_or_die pwsh "$@"

# cwd under $REPOSITORIES → exec native Linux pwsh (no Windows path translation needed).
abs_pwd="$(realpath -m "$PWD" 2>/dev/null || printf '%s' "$PWD")"
if [[ "$(classify_path "$abs_pwd")" == repos ]]; then
    native="$(find_native pwsh)" || { echo "pwsh: no native Linux pwsh on PATH" >&2; exit 1; }
    win_dbg "repos cwd → native Linux pwsh: $native"
    exec "$native" "$@"
fi

# Translate a single arg to a Windows path if it looks like a WSL path.
translate_path() {
    local arg="$1"
    case "$arg" in
        /* | ./* | ../* | ~/* | ~) to_windows_path "$arg" ;;
        *)                          echo "$arg"             ;;
    esac
}

# Flags whose next arg is a path — translate it unconditionally.
PATH_FLAGS_RE='^(-[Ff]ile|-[Ff]ile[Pp]ath|-[Ww]orking[Dd]irectory|-[Cc]onfiguration[Ff]ile|-[Pp][Ss][Cc]onsole[Ff]ile|-[Oo]utput[Ff]ile|-[Ll]og[Ff]ile)$'
# Flags whose next arg must NOT be path-translated (script block or encoded string).
NONTRANS_FLAGS_RE='^(-[Cc]ommand|-[Cc]|-[Ee]ncodedCommand|-[Ee]ncodedC)$'

new_argv=()
next_is_path=false
skip_translate=false

for arg in "$@"; do
    if $next_is_path; then
        win="$(to_windows_path "$arg")"
        win_dbg "flag-forced path: $arg -> $win"
        new_argv+=("$win")
        next_is_path=false
        skip_translate=false
        continue
    fi

    if $skip_translate; then
        win_dbg "skip-translate passthrough: $arg"
        new_argv+=("$arg")
        skip_translate=false
        continue
    fi

    if [[ "$arg" =~ $PATH_FLAGS_RE ]]; then
        win_dbg "path-flag: $arg"
        new_argv+=("$arg")
        next_is_path=true
        continue
    fi

    if [[ "$arg" =~ $NONTRANS_FLAGS_RE ]]; then
        win_dbg "nontrans-flag: $arg"
        new_argv+=("$arg")
        skip_translate=true
        continue
    fi

    translated="$(translate_path "$arg")"
    [[ "$translated" != "$arg" ]] && win_dbg "auto-path: $arg -> $translated"
    new_argv+=("$translated")
done

win_dbg "new_argv=(${new_argv[*]})"

# Determine -WorkingDirectory. to_windows_path returns empty string if wslpath fails
# (e.g. a pure-Linux path like /proc) — omit the flag in that case.
win_cwd="$(to_windows_path "$PWD")"
if [[ -n "$win_cwd" ]]; then
    win_dbg "WorkingDirectory=$win_cwd"
    wd_args=(-WorkingDirectory "$win_cwd")
else
    win_dbg "WorkingDirectory: untranslatable ($PWD), omitting"
    wd_args=()
fi

# cmd.exe prints UNC-path warnings when its working directory is under
# \\wsl.localhost\... — change to a real Windows path before exec.
cd /mnt/c

win_dbg "exec: pwsh.exe ${wd_args[*]} ${new_argv[*]}"
exec pwsh.exe "${wd_args[@]}" "${new_argv[@]}"
