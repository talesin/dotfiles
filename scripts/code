#!/usr/bin/env bash

WIN_SHIM_DBG_VAR=CODE_DEBUG
WIN_SHIM_DBG_PREFIX='code[dbg]'
source "$(dirname "$(realpath "$0")")/win-shim"

WINDOWS_VSCODE_BIN="/mnt/c/Users/$WINDOWS_USERNAME/AppData/Local/Programs/Microsoft VS Code/bin"
# bin/code detects WSL and routes through the Remote-WSL extension (wslCode.sh), which
# rewrites any --folder-uri to a vscode-remote:// target. Use code.cmd via cmd.exe for
# branches that want a native Windows window; keep bin/code only for WSL-remote opens.
WINDOWS_CODE_BASH="$WINDOWS_VSCODE_BIN/code"
WINDOWS_CODE_CMD_WIN="$(wslpath -w "$WINDOWS_VSCODE_BIN/code.cmd")"

win_dbg "HOME=$HOME PWD=$PWD WSL_DISTRO_NAME=${WSL_DISTRO_NAME:-<unset>}"
win_dbg "WINDOWS_USERNAME=$WINDOWS_USERNAME"
win_dbg "WINDOWS_CODE_CMD_WIN=$WINDOWS_CODE_CMD_WIN"
win_dbg "argc=$# argv=($*)"

native_passthrough_or_die code "$@"

# Partition argv into flags and path operands.
# Flags that consume the next token (value flags) are listed here so we don't
# mistake their argument for a path operand.
declare -A CODE_VALUE_FLAGS=(
    [--user-data-dir]=1 [--extensions-dir]=1 [--locale]=1 [--log]=1
    [--max-memory]=1 [--profile]=1 [--sync]=1 [--remote]=1
    [--folder-uri]=1 [--file-uri]=1 [--crash-reporter-directory]=1
)

if [[ $# -eq 0 ]]; then
    target="$(pwd)"; rest=()
else
    flags=(); operands=(); expect_value=0
    for arg in "$@"; do
        if [[ $expect_value -eq 1 ]]; then
            flags+=("$arg"); expect_value=0
        elif [[ "$arg" == -* ]]; then
            flags+=("$arg")
            [[ -n "${CODE_VALUE_FLAGS[$arg]:-}" ]] && expect_value=1
        else
            operands+=("$arg")
        fi
    done
    # 0 operands → pure-flag call (--version, --install-extension …); hand off unchanged.
    # 2+ operands → multi-path call (--diff a b, --merge …); routing is ambiguous, hand off.
    if [[ ${#operands[@]} -ne 1 ]]; then
        win_dbg "operands=${#operands[@]}; passthrough: $*"
        exec "$WINDOWS_CODE_BASH" "$@"
    fi
    target="${operands[0]}"; rest=("${flags[@]}")
fi
abs="$(realpath -m "$target")"
win_dbg "target=$target  abs=$abs"

# cmd.exe prints UNC-path warnings when its working directory is under
# \\wsl.localhost\... — change to a real Windows path before exec.
cd /mnt/c

case "$(classify_path "$abs")" in
    repos)
        win="$(repos_to_windows "$abs")"
        uri="$(uri_encode_spaces "file:///${win//\\//}")"
        win_dbg "branch=repos  win=$win  uri=$uri"
        # Repos are on a subst drive (Z:\) that isn't mounted in WSL, so the
        # path is built by string substitution in repos_to_windows(), not wslpath.
        # Pass an explicit folder/file URI so code.exe doesn't try to stat the
        # path itself (stat fails for subst drives in a WSL-spawned process).
        if [[ -d "$abs" ]]; then
            win_dbg "exec: cmd.exe /c $WINDOWS_CODE_CMD_WIN --folder-uri $uri ${rest[*]}"
            exec cmd.exe /c "$WINDOWS_CODE_CMD_WIN" --folder-uri "$uri" "${rest[@]}"
        else
            win_dbg "exec: cmd.exe /c $WINDOWS_CODE_CMD_WIN --file-uri $uri ${rest[*]}"
            exec cmd.exe /c "$WINDOWS_CODE_CMD_WIN" --file-uri "$uri" "${rest[@]}"
        fi
        ;;
    mnt)
        win="$(wslpath -w "$abs")"
        uri="$(uri_encode_spaces "file:///${win//\\//}")"
        win_dbg "branch=mnt  win=$win  uri=$uri"
        if [[ -d "$abs" ]]; then
            win_dbg "exec: cmd.exe /c $WINDOWS_CODE_CMD_WIN --folder-uri $uri ${rest[*]}"
            exec cmd.exe /c "$WINDOWS_CODE_CMD_WIN" --folder-uri "$uri" "${rest[@]}"
        else
            win_dbg "exec: cmd.exe /c $WINDOWS_CODE_CMD_WIN --file-uri $uri ${rest[*]}"
            exec cmd.exe /c "$WINDOWS_CODE_CMD_WIN" --file-uri "$uri" "${rest[@]}"
        fi
        ;;
    other)
        if [[ -z "${WSL_DISTRO_NAME-}" ]]; then
            echo "code: WSL_DISTRO_NAME unset; cannot build wsl+<distro> authority" >&2
            exit 1
        fi
        authority="wsl+$WSL_DISTRO_NAME"
        uri="$(uri_encode_spaces "vscode-remote://${authority}${abs}")"
        win_dbg "branch=remote  authority=$authority  uri=$uri"
        if [[ -d "$abs" ]]; then
            win_dbg "exec: cmd.exe /c $WINDOWS_CODE_CMD_WIN --folder-uri $uri ${rest[*]}"
            exec cmd.exe /c "$WINDOWS_CODE_CMD_WIN" --folder-uri "$uri" "${rest[@]}"
        else
            win_dbg "exec: cmd.exe /c $WINDOWS_CODE_CMD_WIN --file-uri $uri ${rest[*]}"
            exec cmd.exe /c "$WINDOWS_CODE_CMD_WIN" --file-uri "$uri" "${rest[@]}"
        fi
        ;;
esac
