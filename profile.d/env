# Shared environment variables for both zsh and bash
# This file is sourced by both zshenv and bash_profile

# A non-login shell inherits PATH verbatim, and a parent can hand it one without
# the system directories (an editor extension injecting a project .env, say).
# Everything below needs them, so restore them first: path_helper on macOS, the
# conventional set elsewhere.
case ":$PATH:" in
    *:/usr/bin:*) ;;
    *)
        if [ -x /usr/libexec/path_helper ]; then
            eval "$(/usr/libexec/path_helper -s)"
        else
            export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}"
        fi
        ;;
esac

# Load local environment overrides
if [ -f $HOME/.config/env.local ]; then
    source $HOME/.config/env.local
fi

# Node.js
export NODE_ENV=local
export NVM_DIR=$HOME/.nvm
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Rust
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Xcode path for VSCode
export MD_APPLE_SDK_ROOT=/Applications/Xcode.app

# WSL: use the default Windows browser for URL opening
if [ -n "$WSL_DISTRO_NAME" ] && command -v wslview >/dev/null 2>&1; then
    export BROWSER=wslview
fi

export EDITOR=vim

# .NET
export DOTNET_ROOT="$HOME/.dotnet"
export DOTNET_CLI_TELEMETRY_OPTOUT=1
